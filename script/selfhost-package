#!/bin/bash
# Packages PRAW: a self-contained, Warp-infrastructure-free build for macOS:
#
#   dist/PRAW-macos-universal/
#     PRAW.app                      GUI; auto-starts the bundled backend
#     bin/praw                      CLI: start/backend/status/stop/doctor/logs
#     bin/selfhost_server           agent backend binary
#     bin/PRAW-tui              TUI front-end
#     Install PRAW.command          clears quarantine + opens PRAW + installs
#                                   the praw CLI onto PATH
#     README.txt                    setup instructions
#
# and zips it to dist/PRAW-macos-universal.zip plus a drag-to-install
# dist/PRAW-macos-universal.dmg. Builds release binaries first unless
# SKIP_BUILD=1 is exported.

set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")"/.. && pwd)"
cd "$REPO_ROOT"

STAGE_ROOT="dist/PRAW-macos-universal"
APP="$STAGE_ROOT/PRAW.app"
PLIST="$APP/Contents/Info.plist"
MACOS_DIR="$APP/Contents/MacOS"
RESOURCES_DIR="$APP/Contents/Resources"
ICON_SRC="resources/parw/icon_1024.png"
DMG_BACKGROUND="resources/parw/dmg_background.png"

# Version shown in Finder/About (overridable for local test builds).
VERSION="${PARW_VERSION:-$(git describe --tags --match 'parw-v*' --abbrev=0 2>/dev/null | sed 's/^parw-v//')}"
VERSION="${VERSION:-selfhost-dev}"

# The app-internal backend port. 8080 is the most collision-prone dev port
# (and MLX-LM's default), so the bundled pair uses an uncommon one; the
# launcher's default and this URL must agree. Manual `selfhost_server` runs
# still default to 8080.
BACKEND_PORT=48080

if [[ "${SKIP_BUILD:-0}" != "1" ]]; then
    cargo build --release -p warp --bin warp-oss
    cargo build --release -p warp_tui --bin warp-tui-oss
    cargo build --release -p selfhost_server --bin selfhost_server
    cargo build --release -p selfhost_server --bin parw_launcher

    # Optional x86_64 slices so the package also runs on Intel Macs. Skipped
    # when the target is unavailable; the package is then Apple Silicon only.
    if rustup target add x86_64-apple-darwin >/dev/null 2>&1; then
        cargo build --release --target x86_64-apple-darwin -p warp --bin warp-oss
        cargo build --release --target x86_64-apple-darwin \
            -p warp_tui --bin warp-tui-oss
        cargo build --release --target x86_64-apple-darwin \
            -p selfhost_server --bin selfhost_server
        cargo build --release --target x86_64-apple-darwin \
            -p selfhost_server --bin parw_launcher
    else
        echo "x86_64 target unavailable; packaging Apple Silicon only."
    fi
fi

rm -rf "$STAGE_ROOT" "$STAGE_ROOT.zip"
mkdir -p "$MACOS_DIR" "$RESOURCES_DIR" "$STAGE_ROOT/bin"

# ── Universal binary helper ─────────────────────────────────────────────────
# Fat arm64+x86_64 when the x86_64 slice was built; otherwise arm64-only.
build_universal_bin() {
    local name="$1"
    local arm="target/release/$name"
    local x86="target/x86_64-apple-darwin/release/$name"
    if [[ -f "$x86" ]]; then
        lipo -create "$arm" "$x86" -output "$STAGE_ROOT/bin/$name"
    else
        cp "$arm" "$STAGE_ROOT/bin/$name"
    fi
}

APP="$STAGE_ROOT/PRAW.app"
PLIST="$APP/Contents/Info.plist"
MACOS_DIR="$APP/Contents/MacOS"
RESOURCES_DIR="$APP/Contents/Resources"
mkdir -p "$MACOS_DIR" "$RESOURCES_DIR" "$STAGE_ROOT/bin"

# Universal (arm64 + x86_64) when the x86_64 slice was built; otherwise
# arm64-only. warp-oss, selfhost_server, and PRAWLauncher all live inside the
# .app so it is fully self-contained; the TUI goes in bin/.
stage_universal() {
    local name="$1"
    local arm="target/release/$name"
    local x86="target/x86_64-apple-darwin/release/$name"
    if [[ -f "$x86" ]]; then
        lipo -create "$arm" "$x86" -output "$STAGE_ROOT/bin/$name"
    else
        cp "$arm" "$STAGE_ROOT/bin/$name"
    fi
}
stage_universal warp-oss
stage_universal selfhost_server
stage_universal warp-tui-oss
mv "$STAGE_ROOT/bin/warp-tui-oss" "$STAGE_ROOT/bin/PRAW-tui"
stage_universal parw_launcher

mv "$STAGE_ROOT/bin/warp-oss" "$MACOS_DIR/warp-oss"
mv "$STAGE_ROOT/bin/parw_launcher" "$MACOS_DIR/PRAWLauncher"
# Keep a copy of the backend in bin/ too for TUI users (README references it).
cp "$STAGE_ROOT/bin/selfhost_server" "$MACOS_DIR/selfhost_server"

# Command-line control, installed onto PATH by Install PRAW.command.
cp script/praw "$STAGE_ROOT/bin/praw"
chmod +x "$STAGE_ROOT/bin/praw"

if [[ -f "$ICON_SRC" ]]; then
    if ICONSET="$STAGE_ROOT/icon.iconset"; mkdir -p "$ICONSET"; then
        sips -z 512 512 "$ICON_SRC" --out "$ICONSET/icon_512x512.png" >/dev/null 2>&1 || true
        if iconutil -c icns "$ICONSET" -o "$RESOURCES_DIR/icon.icns" 2>/dev/null; then
            ICON_KEY='<key>CFBundleIconFile</key><string>icon.icns</string>'
        fi
        rm -rf "$ICONSET"
    fi
fi

cat > "$PLIST" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>CFBundlePackageType</key><string>APPL</string>
    <key>CFBundleExecutable</key><string>PRAWLauncher</string>
    <key>CFBundleIdentifier</key><string>dev.parw.PRAW</string>
    <key>CFBundleName</key><string>PRAW</string>
    <key>CFBundleDisplayName</key><string>PRAW</string>
    <key>CFBundleShortVersionString</key><string>${VERSION}</string>
    <key>CFBundleVersion</key><string>${VERSION}</string>
    <key>NSHighResolutionCapable</key><true/>
    <key>LSMinimumSystemVersion</key><string>11.0</string>
    ${ICON_KEY:-}
    <key>LSEnvironment</key>
    <dict>
        <key>WARP_SELF_HOSTED_SERVER_URL</key>
        <string>http://127.0.0.1:${BACKEND_PORT}</string>
    </dict>
</dict>
</plist>
PLIST

if [[ -d app/assets/onboarding ]]; then
    mkdir -p "$RESOURCES_DIR/assets"
    cp -R app/assets/onboarding "$RESOURCES_DIR/assets/"
fi

cat > "$STAGE_ROOT/Install PRAW.command" <<'INSTALLER'
#!/bin/bash
cd "$(dirname "$0")"
echo "Removing the macOS quarantine flag from PRAW.app..."
xattr -dr com.apple.quarantine "PRAW.app" 2>/dev/null || sudo xattr -dr com.apple.quarantine "PRAW.app"
echo "Starting PRAW (backend starts automatically with the app)..."
open "PRAW.app"

# Install the `praw` command-line tool (copied, not linked: the DMG goes away).
if [[ -f "bin/praw" ]]; then
    installed=""
    for dir in /opt/homebrew/bin /usr/local/bin "$HOME/.local/bin"; do
        if [[ -d "$dir" && -w "$dir" ]]; then
            cp "bin/praw" "$dir/praw" && chmod +x "$dir/praw" && installed="$dir" && break
        fi
    done
    if [[ -z "$installed" ]]; then
        sudo install -m 0755 "bin/praw" /usr/local/bin/praw 2>/dev/null && installed=/usr/local/bin
    fi
    if [[ -n "$installed" ]]; then
        echo "Installed the 'praw' command to $installed/praw."
        if [[ "$installed" == "$HOME/.local/bin" && ":$PATH:" != *":$HOME/.local/bin:"* ]]; then
            echo "Note: add $HOME/.local/bin to your PATH to use it."
        fi
    fi
fi
echo "Done. PRAW is in your Applications folder; try 'praw status'."
INSTALLER
chmod +x "$STAGE_ROOT/Install PRAW.command"

cat > "$STAGE_ROOT/README.txt" <<README
PRAW ${VERSION} — self-hosted build
===================================

Everything here talks only to your machine: the agent backend (bundled with
PRAW.app) and whatever LLM endpoint you point it at. No Warp cloud services,
no telemetry, no crash reporting, no autoupdate. No login, no subscription.

Quick start (macOS, Apple Silicon or Intel):
  1. Drag PRAW.app into /Applications (or keep it anywhere).
  2. Because the build is unsigned, clear the quarantine flag after transfer:
         xattr -dr com.apple.quarantine /Applications/PRAW.app
     or double-click "Install PRAW.command" next to the app.
  3. Open PRAW. It starts its own agent backend automatically.
  4. Type a prompt prefixed with "#" to use the agent.

LLM backends (autodetected in order):
  - Ollama     http://127.0.0.1:11434
  - LM Studio  http://127.0.0.1:1234
  - MLX-LM     http://127.0.0.1:8080
Detected models appear in the model picker. Force one with
  PRAW.app/Contents/MacOS/selfhost_server --llm-backend ollama
or point at any OpenAI-compatible endpoint with --llm-base-url.
Run .../selfhost_server --doctor to check detection, keys, and ports.

Cloud providers (optional):
  --provider chatgpt         first run --codex-login to sign in with ChatGPT
  --provider azure-foundry   --azure-tenant/--azure-client-id/--azure-client-secret/--azure-foundry-url
  --provider vertex --vertex gcloud auth application-default login
  --provider zai|opencode|xai|openai|anthropic|google|openrouter  with --<name>-api-key

Also in this folder:
  bin/praw         command-line control: start/backend/status/stop/doctor/logs
  bin/PRAW-tui     terminal UI front-end
  Inside PRAW.app the backend serves /healthz and /metrics on
  127.0.0.1:${BACKEND_PORT} (backend log: ~/Library/Logs/PRAW-backend.log;
  it rotates at 10 MB). A backend you start by hand defaults to port 8080.

Notes:
  - The backend listens on loopback only. If you expose it to your network,
    require a key: --api-key <secret>, and set the same value in the client
    via WARP_API_KEY.
  - Client auth for the server: any key is accepted by default; the client
    self-registers with a placeholder key.
  - Voice transcription and web search are available if you run an STT
    endpoint (--transcribe-base-url) or SearXNG (--web-search-url).
README

# ── Sign + zip + DMG ────────────────────────────────────────────────────────
codesign --force --deep -s - "$APP" 2>/dev/null || true
codesign --force -s - "$STAGE_ROOT/bin/selfhost_server" 2>/dev/null || true
codesign --force -s - "$STAGE_ROOT/bin/PRAW-tui" 2>/dev/null || true

(cd dist && zip -qr "PRAW-macos-universal.zip" "PRAW-macos-universal")

# ── DMG ─────────────────────────────────────────────────────────────────────
# Drag-to-install layout: background art, positioned icons, an Applications
# symlink, and a right-sized window. Built by hand (UDRW → decorated → UDZO)
# because `hdiutil -srcfolder` can't do any of that. Finder automation is
# best-effort; without it the DMG still builds, just with default layout.
build_fancy_dmg() {
    local src="$1" dmg="$2"
    local rw="dist/PRAW-rw.dmg"
    rm -f "$rw"
    local size_mb=$(( $(du -sk "$src" | cut -f1) / 1024 * 13 / 10 + 64 ))
    hdiutil create -size "${size_mb}m" -fs "HFS+" -volname PRAW \
        "$rw" >/dev/null || return 1
    # Mount at the default /Volumes location: Finder only scripts disks it
    # can see there. Resolve the real name in case "PRAW" was taken.
    local attach_output mount_point vol_name
    if ! attach_output=$(hdiutil attach "$rw" -nobrowse); then
        return 1
    fi
    mount_point=$(printf '%s\n' "$attach_output" | awk 'NF { point = $NF } END { print point }')
    vol_name=$(basename "$mount_point")
    cp -R "$src"/ "$mount_point/" || { hdiutil detach "$mount_point" -force -quiet; return 1; }
    ln -s /Applications "$mount_point/Applications"
    if [[ -f "$DMG_BACKGROUND" ]]; then
        mkdir -p "$mount_point/.background"
        cp "$DMG_BACKGROUND" "$mount_point/.background/background.png"
    fi
    # The alarm survives exec, so a stuck automation prompt can't hang the
    # build; the DMG still converts with a default layout.
    perl -e 'alarm 30; exec @ARGV' osascript <<LAYOUT >/dev/null 2>&1 || true
tell application "Finder"
    tell disk "${vol_name}"
        open
        set current view of container window to icon view
        set toolbar visible of container window to false
        set statusbar visible of container window to false
        set bounds of container window to {200, 160, 860, 560}
        set viewOptions to icon view options of container window
        set arrangement of viewOptions to not arranged
        set icon size of viewOptions to 120
        set background picture of viewOptions to file ".background:background.png"
        set position of item "PRAW.app" of container window to {165, 225}
        set position of item "Applications" of container window to {495, 225}
        close
        open
        update without registering applications
    end tell
end tell
LAYOUT
    sleep 2
    hdiutil detach "$mount_point" -quiet || hdiutil detach "$mount_point" -force -quiet || return 1
    rm -f "$dmg"
    hdiutil convert "$rw" -format UDZO -o "$dmg" >/dev/null || return 1
    rm -f "$rw"
}

if build_fancy_dmg "$STAGE_ROOT" "dist/PRAW-macos-universal.dmg"; then
    :
else
    echo "Decorated DMG unavailable; building a plain one."
    hdiutil detach "/Volumes/PRAW" -force -quiet >/dev/null 2>&1 || true
    rm -f "dist/PRAW-rw.dmg"
    hdiutil create -volname PRAW -srcfolder "$STAGE_ROOT" -ov -format UDZO \
        "dist/PRAW-macos-universal.dmg" >/dev/null
fi

echo
echo "Packaged: PRAW ${VERSION}"
echo "Zip:      dist/PRAW-macos-universal.zip"
echo "DMG:      dist/PRAW-macos-universal.dmg"
echo "Folder:   $STAGE_ROOT"
