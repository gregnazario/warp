#!/bin/bash
# praw — command-line control for PRAW (the self-hosted agent terminal).
#
#   praw [start]   start the backend (if needed) and open PRAW.app
#   praw backend   start just the agent backend
#   praw status    backend health, app location, port
#   praw stop      quit PRAW.app and stop the backend
#   praw doctor    run the bundled selfhost_server --doctor
#   praw logs      follow the backend log
#   praw update    install the latest release over the local PRAW.app
#   praw config    show (or create a template) server.toml beside the UI data
#
# Environment:
#   PRAW_APP          path to PRAW.app (otherwise searched)
#   PRAW_BACKEND_PORT backend port (default 48080, same as the app launcher)

set -u

PORT="${PRAW_BACKEND_PORT:-48080}"
LOG="${HOME}/Library/Logs/PRAW-backend.log"
MAX_LOG_BYTES=$((10 * 1024 * 1024))

usage() {
    sed -n '2,13p' "${BASH_SOURCE[0]}" | sed 's/^# \{0,1\}//'
    exit "${1:-0}"
}

find_app() {
    local candidate
    for candidate in "${PRAW_APP:-}" \
        "$HOME/Applications/PRAW.app" \
        "/Applications/PRAW.app" \
        "$(cd "$(dirname "${BASH_SOURCE[0]}")/.." 2>/dev/null && pwd)/PRAW.app"; do
        if [[ -n "$candidate" && -d "$candidate" ]]; then
            printf '%s\n' "$candidate"
            return 0
        fi
    done
    return 1
}

backend_healthy() {
    [[ "$(curl -s -o /dev/null -m 1 -w '%{http_code}' "http://127.0.0.1:${PORT}/healthz")" == "200" ]]
}

backend_pid() {
    local pid
    for pid in $(lsof -ti "tcp:${PORT}" -sTCP:LISTEN 2>/dev/null); do
        if ps -p "$pid" -o comm= 2>/dev/null | grep -q 'selfhost_server'; then
            printf '%s\n' "$pid"
            return 0
        fi
    done
    return 1
}

start_backend() {
    if backend_healthy; then
        echo "Backend already running on http://127.0.0.1:${PORT}."
        return 0
    fi
    local app backend
    app=$(find_app) || {
        echo "error: PRAW.app not found (set PRAW_APP or install the app)." >&2
        return 1
    }
    backend="$app/Contents/MacOS/selfhost_server"
    [[ -x "$backend" ]] || {
        echo "error: backend missing at $backend" >&2
        return 1
    }
    if [[ -f "$LOG" && "$(stat -f %z "$LOG")" -gt "$MAX_LOG_BYTES" ]]; then
        mv "$LOG" "${LOG}.old"
    fi
    echo "Starting backend on http://127.0.0.1:${PORT} ..."
    nohup "$backend" --bind "127.0.0.1:${PORT}" >>"$LOG" 2>&1 &
    local waited=0
    until backend_healthy; do
        # Cold starts can take a while: autodetect probes every candidate
        # backend, including ones that accept TCP but answer slowly.
        if ((waited >= 30)); then
            echo "error: backend did not become healthy; see $LOG" >&2
            return 1
        fi
        sleep 0.5
        waited=$((waited + 1))
    done
    echo "Backend is healthy (log: $LOG)."
}

cmd_start() {
    start_backend || return 1
    local app
    app=$(find_app) || return 1
    open "$app"
    echo "PRAW is open."
}


cmd_update() {
    local repo="gregnazario/warp"
    local api="https://api.github.com/repos/${repo}/releases/latest"

    echo "Checking the latest PRAW release..."
    local payload tag dmg_url
    payload=$(curl -s -m 15 "$api") || { echo "error: could not reach GitHub" >&2; return 1; }
    tag=$(printf '%s' "$payload" | sed -n 's/.*"tag_name": *"\([^"]*\)".*/\1/p' | head -1)
    dmg_url=$(printf '%s' "$payload" \
        | sed -n 's/.*"browser_download_url": *"\([^"]*PRAW-macos-universal.dmg\)".*/\1/p' | head -1)
    [[ -n "$tag" && -n "$dmg_url" ]] || { echo "error: no release with a DMG found" >&2; return 1; }

    local app current=""
    app=$(find_app) || app="/Applications/PRAW.app"
    [[ -d "$app" ]] && current=$(/usr/libexec/PlistBuddy -c 'Print :CFBundleShortVersionString' \
        "$app/Contents/Info.plist" 2>/dev/null)
    if [[ "$current" == "${tag#parw-v}" ]]; then
        echo "Already up to date (${tag})."
        return 0
    fi
    echo "Updating ${current:-<not installed>} -> ${tag#parw-v} ..."

    local tmp
    tmp=$(mktemp -d /tmp/praw-update.XXXXXX) || return 1
    echo "Downloading ${tag} ..."
    curl -sL -m 600 -o "$tmp/PRAW.dmg" "$dmg_url" || { echo "error: download failed" >&2; return 1; }

    echo "Quitting PRAW..."
    osascript -e 'tell application "PRAW" to quit' >/dev/null 2>&1
    sleep 2
    pkill -f 'PRAW.app/Contents/MacOS/warp-oss' 2>/dev/null
    pkill -f 'selfhost_server --bind' 2>/dev/null
    sleep 2

    hdiutil attach "$tmp/PRAW.dmg" -nobrowse -quiet || { echo "error: mount failed" >&2; return 1; }
    local mounted="/Volumes/PRAW"
    [[ -d "$mounted/PRAW.app" ]] || mounted=$(ls -d /Volumes/PRAW*/ 2>/dev/null | head -1)
    [[ -d "$mounted/PRAW.app" ]] || { echo "error: DMG layout unexpected" >&2; hdiutil detach "/Volumes/PRAW" -quiet; return 1; }

    echo "Replacing $app ..."
    rm -rf "$app"
    cp -R "$mounted/PRAW.app" "$app" || { echo "error: copy failed" >&2; hdiutil detach "$mounted" -quiet; return 1; }
    # Refresh this script if it is an installed copy, not the DMG's own.
    if [[ -f "$mounted/bin/praw" && "${BASH_SOURCE[0]}" != */PRAW-macos-universal/* ]]; then
        cp "$mounted/bin/praw" "${BASH_SOURCE[0]}" 2>/dev/null \
            && echo "Updated the praw command at ${BASH_SOURCE[0]}."
    fi
    hdiutil detach "$mounted" -quiet
    rm -rf "$tmp"
    xattr -c "$app" >/dev/null 2>&1

    echo "Relaunching..."
    open "$app"
    sleep 10
    local health
    health=$(curl -s -o /dev/null -m 5 -w '%{http_code}' "http://127.0.0.1:${PORT}/healthz" 2>/dev/null)
    if [[ "$health" == "200" ]]; then
        echo "Update to ${tag#parw-v} complete (backend healthy)."
    else
        echo "Installed ${tag#parw-v}, but the backend is not healthy yet; see $LOG."
    fi
}


CONFIG_PATH="${PRAW_SERVER_CONFIG:-$HOME/Library/Application Support/dev.parw.PRAW/server.toml}"

cmd_config() {
    if [[ "${1:-}" == "--init" ]]; then
        if [[ -f "$CONFIG_PATH" ]]; then
            echo "Config already exists at $CONFIG_PATH"
            return 0
        fi
        mkdir -p "$(dirname "$CONFIG_PATH")"
        cat > "$CONFIG_PATH" <<'TEMPLATE'
# PRAW server config. CLI flags and SELFHOST_* environment variables
# override anything set here. Restart the backend (praw stop && praw start)
# after editing. All keys are optional.

#bind = "127.0.0.1:48080"
#llm_backend = "auto"            # auto | ollama | lmstudio | mlx
#llm_base_url = ""               # any OpenAI/Anthropic-compatible endpoint
#llm_model = ""
#llm_models = ["model-a", "model-b"]
#llm_api_key = ""
#provider = ""                   # openai|anthropic|google|xai|zai|opencode|openrouter|meta|azure-foundry|vertex|chatgpt
#byok_direct = true              # client BYOK keys route natively

# Provider keys (one line each, uncomment what you use):
#openai_api_key = ""
#anthropic_api_key = ""
#google_api_key = ""
#xai_api_key = ""
#zai_api_key = ""
#opencode_api_key = ""
#openrouter_api_key = ""
#meta_api_key = ""

# Azure Foundry (after --foundry-login, or full principal here):
#azure_foundry_url = ""
#azure_tenant = ""
#azure_client_id = ""
#azure_client_secret = ""

#vertex = true                   # after --vertex-login

#web_search_url = ""             # SearXNG endpoint
#transcribe_base_url = ""         # OpenAI-compatible STT endpoint
#transcribe_model = "whisper-1"
#context_window_tokens = 0       # 0 = auto
#api_key = ""                    # require clients to present this bearer
TEMPLATE
        echo "Created a commented template at $CONFIG_PATH"
        echo "Edit it, then: praw stop && praw start"
        return 0
    fi
    if [[ -f "$CONFIG_PATH" ]]; then
        echo "$CONFIG_PATH (present):"
        grep -vE '^\s*(#|$)' "$CONFIG_PATH" | sed -E 's/(key|secret|token)\s*=\s*".*"/\1 = "***"/'
    else
        echo "$CONFIG_PATH (not present — run 'praw config --init' for a template)"
    fi
}

cmd_stop() {
    osascript -e 'tell application "PRAW" to quit' >/dev/null 2>&1 || true
    local pid
    if pid=$(backend_pid); then
        kill "$pid" && echo "Backend stopped."
    else
        echo "Backend not running."
    fi
}

cmd_status() {
    local app="not found"
    app=$(find_app 2>/dev/null) || true
    echo "app:      $app"
    if backend_healthy; then
        echo "backend:  healthy on http://127.0.0.1:${PORT} (pid $(backend_pid))"
    else
        echo "backend:  not running (port ${PORT} free or used by something else)"
    fi
}

cmd_doctor() {
    local app backend
    app=$(find_app) || {
        echo "error: PRAW.app not found (set PRAW_APP or install the app)." >&2
        return 1
    }
    exec "$app/Contents/MacOS/selfhost_server" --doctor "$@"
}

cmd_logs() {
    [[ -f "$LOG" ]] || { echo "No backend log at $LOG yet."; return 0; }
    tail -n 50 -f "$LOG"
}

case "${1:-start}" in
    start) cmd_start ;;
    backend) start_backend ;;
    status) cmd_status ;;
    stop) cmd_stop ;;
    update) cmd_update ;;
    config) shift; cmd_config "$@" ;;
    doctor) shift; cmd_doctor "$@" ;;
    logs) cmd_logs ;;
    help|-h|--help) usage 0 ;;
    *) echo "Unknown command: $1" >&2; usage 1 ;;
esac
